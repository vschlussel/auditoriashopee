<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gerador de Etiquetas Shopee</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 20px;
      min-height: 100vh;
    }

    .header {
      max-width: 1200px;
      margin: 0 auto 20px;
      color: white;
      text-align: center;
    }

    .header h1 {
      font-size: 32px;
      margin-bottom: 5px;
    }

    .header p {
      opacity: 0.9;
      font-size: 14px;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      background: white;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .tabs {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      gap: 0;
      background: #f8f9fa;
      border-bottom: 2px solid #e1e4e8;
    }

    .tab-button {
      padding: 15px 20px;
      border: none;
      background: transparent;
      cursor: pointer;
      font-size: 14px;
      font-weight: 600;
      color: #586069;
      border-bottom: 3px solid transparent;
      transition: all 0.3s;
    }

    .tab-button:hover {
      background: #eff6ff;
      color: #0c2d6b;
    }

    .tab-button.active {
      color: #667eea;
      border-bottom-color: #667eea;
      background: #eff6ff;
    }

    .tab-content {
      display: none;
      padding: 30px;
      animation: fadeIn 0.3s ease;
    }

    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    h2 {
      color: #24292e;
      font-size: 18px;
      margin-bottom: 15px;
      border-bottom: 2px solid #667eea;
      padding-bottom: 10px;
    }

    .upload-area {
      border: 2px dashed #667eea;
      border-radius: 8px;
      padding: 40px;
      text-align: center;
      background: #eff6ff;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 20px;
    }

    .upload-area:hover {
      border-color: #764ba2;
      background: #f0e7ff;
    }

    .upload-area.dragover {
      border-color: #10b981;
      background: #ecfdf5;
    }

    .upload-area p {
      color: #586069;
      margin: 10px 0;
      font-size: 14px;
    }

    .upload-area strong {
      color: #667eea;
      font-size: 16px;
    }

    input[type="file"] {
      display: none;
    }

    .button-group {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 10px;
      margin: 20px 0;
    }

    button {
      padding: 12px 20px;
      font-size: 13px;
      font-weight: 600;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.2s;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .btn-primary {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      font-size: 14px;
      padding: 13px 20px;
    }

    .btn-primary:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    }

    .btn-secondary {
      background: #f3f4f6;
      color: #374151;
      border: 1px solid #d1d5db;
    }

    .btn-secondary:hover {
      background: #e5e7eb;
    }

    .btn-success {
      background: #10b981;
      color: white;
    }

    .btn-success:hover:not(:disabled) {
      background: #059669;
    }

    .btn-danger {
      background: #ef4444;
      color: white;
    }

    .btn-danger:hover {
      background: #dc2626;
    }

    .btn-primary:disabled, .btn-success:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }

    .preview-container {
      border: 2px dashed #d1d5db;
      border-radius: 8px;
      padding: 20px;
      background: #fafbfc;
      min-height: 400px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 20px 0;
    }

    .preview-container canvas,
    .preview-container img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      border-radius: 4px;
    }

    .preview-placeholder {
      text-align: center;
      color: #9ca3af;
    }

    .preview-placeholder p {
      margin: 10px 0;
    }

    textarea {
      width: 100%;
      min-height: 250px;
      padding: 12px;
      font-family: 'Monaco', monospace;
      font-size: 12px;
      border: 1px solid #e1e4e8;
      border-radius: 6px;
      resize: vertical;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    textarea:focus {
      outline: none;
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .status-message {
      padding: 12px 16px;
      border-radius: 6px;
      margin: 15px 0;
      font-size: 13px;
      display: none;
      animation: slideIn 0.3s ease;
    }

    .status-message.show {
      display: block;
    }

    .status-message.success {
      background: #ecfdf5;
      color: #065f46;
      border: 1px solid #a7f3d0;
    }

    .status-message.error {
      background: #fef2f2;
      color: #7f1d1d;
      border: 1px solid #fecaca;
    }

    .status-message.info {
      background: #eff6ff;
      color: #0c2d6b;
      border: 1px solid #bfdbfe;
    }

    @keyframes slideIn {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .info-box {
      background: #eff6ff;
      border-left: 4px solid #3b82f6;
      padding: 15px;
      border-radius: 4px;
      font-size: 13px;
      color: #0c2d6b;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .file-list {
      margin-top: 20px;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 6px;
      border: 1px solid #e1e4e8;
    }

    .file-item {
      padding: 10px;
      background: white;
      border-radius: 4px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
    }

    .file-item strong {
      color: #667eea;
    }

    .loading {
      display: none;
      text-align: center;
      margin: 20px 0;
    }

    .spinner {
      border: 3px solid #f3f3f3;
      border-top: 3px solid #667eea;
      border-radius: 50%;
      width: 30px;
      height: 30px;
      animation: spin 1s linear infinite;
      margin: 0 auto 10px;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    @media (max-width: 768px) {
      .tabs {
        grid-template-columns: 1fr;
      }

      .header h1 {
        font-size: 24px;
      }

      .tab-content {
        padding: 20px;
      }
    }
  </style>
</head>
<body>

<div class="header">
  <h1>🏷️ Gerador de Etiquetas Shopee</h1>
  <p>Visualize, edite e imprima etiquetas - Integrado com Vercel Backend</p>
</div>

<div class="container">
  <!-- ABAS -->
  <div class="tabs">
    <button class="tab-button active" onclick="abrirAba('upload')">
      📤 UPLOAD (ZPL/PDF)
    </button>
    <button class="tab-button" onclick="abrirAba('editor')">
      ✏️ EDITOR ZPL
    </button>
    <button class="tab-button" onclick="abrirAba('info')">
      📖 COMO USAR
    </button>
  </div>

  <!-- ABA 1: UPLOAD -->
  <div id="upload" class="tab-content active">
    <div class="info-box">
      ✅ Carregue arquivo ZPL (.txt) ou PDF da Shopee. Renderização automática via Vercel!
    </div>

    <h2>📤 Carregar Arquivo ZPL</h2>
    
    <div class="upload-area" id="uploadArea" onclick="document.getElementById('fileInput').click()">
      <p><strong>Clique ou arraste</strong> seu arquivo de etiqueta</p>
      <p style="font-size: 12px; opacity: 0.7;">Arquivo .txt ZPL ou PDF</p>
    </div>

    <input type="file" id="fileInput" accept=".txt,.zpl,.pdf" onchange="handleFileSelect(event)">

    <div class="file-list" id="fileList" style="display: none;">
      <strong>Arquivo carregado:</strong>
      <div class="file-item">
        <div>
          <strong id="fileName"></strong>
          <br>
          <small id="fileSize" style="color: #999;"></small>
        </div>
        <button class="btn-danger" onclick="limparArquivo()" style="padding: 6px 12px; font-size: 11px;">Remover</button>
      </div>
    </div>

    <div class="button-group">
      <button id="btnConverter" class="btn-primary" onclick="converterZPL()">
        🚀 CONVERTER
      </button>
    </div>

    <div class="loading" id="loading">
      <div class="spinner"></div>
      <p>Processando etiqueta no Vercel...</p>
    </div>

    <div class="preview-container" id="preview">
      <div class="preview-placeholder">
        <p style="font-size: 24px;">📋</p>
        <p>Sua etiqueta aparecerá aqui</p>
      </div>
    </div>

    <div class="button-group">
      <button id="btnDownload" class="btn-success" disabled onclick="baixar()">
        ⬇️ BAIXAR PNG
      </button>
      <button id="btnImprimir" class="btn-secondary" disabled onclick="imprimir()">
        🖨️ IMPRIMIR
      </button>
    </div>

    <div id="status" class="status-message"></div>
  </div>

  <!-- ABA 2: EDITOR -->
  <div id="editor" class="tab-content">
    <div class="info-box">
      ✏️ Edite código ZPL e veja preview em tempo real
    </div>

    <h2>📝 Código ZPL</h2>
    
    <textarea id="zplCode" placeholder="Cole código ZPL aqui...">^XA
^FO30,30^A0N,60,60^FDAuditório Shopee^FS
^FO30,110^A0N,35,35^FDProduto Premium^FS
^FO30,170^A0N,25,25^FDCódigo: 123456789^FS
^FO30,220^A0N,25,25^FDSKU: SKU-2024-001^FS
^FO30,270^A0N,25,25^FDPreço: R$ 99,90^FS
^FO30,320^A0N,20,20^FDValidade: 31/12/2025^FS
^XZ</textarea>

    <div class="button-group">
      <button class="btn-primary" onclick="converterZPLEditor()">🎨 RENDERIZAR</button>
      <button class="btn-secondary" onclick="limparEditor()">🗑️ Limpar</button>
    </div>

    <div class="loading" id="loadingEditor">
      <div class="spinner"></div>
      <p>Renderizando no Vercel...</p>
    </div>

    <div class="preview-container" id="previewEditor">
      <div class="preview-placeholder">
        <p style="font-size: 24px;">🎨</p>
        <p>Imagem será gerada aqui</p>
      </div>
    </div>

    <div class="button-group">
      <button id="btnDownloadEditor" class="btn-success" disabled onclick="baixarEditor()">
        ⬇️ BAIXAR PNG
      </button>
      <button id="btnImprimirEditor" class="btn-secondary" disabled onclick="imprimirEditor()">
        🖨️ IMPRIMIR
      </button>
    </div>

    <div id="statusEditor" class="status-message"></div>
  </div>

  <!-- ABA 3: INFO -->
  <div id="info" class="tab-content">
    <h2>❓ Como Usar</h2>

    <div class="section" style="margin-top: 20px;">
      <h3 style="font-size: 16px; color: #333; margin-bottom: 10px;">🎯 Opção 1: Converter Etiqueta da Shopee</h3>
      <ol style="margin-left: 20px; line-height: 1.8; color: #666; font-size: 14px;">
        <li>Acesse <strong>Shopee Seller → Envios → Etiquetas</strong></li>
        <li>Baixe o arquivo de etiqueta (extensão .txt com código ZPL)</li>
        <li>Volte aqui e clique em <strong>"Clique ou arraste"</strong></li>
        <li>Selecione o arquivo .txt</li>
        <li>Clique em <strong>"CONVERTER"</strong></li>
        <li>Aguarde o processamento no Vercel</li>
        <li>Clique em <strong>"BAIXAR"</strong> ou <strong>"IMPRIMIR"</strong></li>
      </ol>
    </div>

    <div class="section" style="margin-top: 20px;">
      <h3 style="font-size: 16px; color: #333; margin-bottom: 10px;">✏️ Opção 2: Editar ZPL Personalizado</h3>
      <ol style="margin-left: 20px; line-height: 1.8; color: #666; font-size: 14px;">
        <li>Vá para a aba <strong>"EDITOR ZPL"</strong></li>
        <li>Edite o código ou carregue seu próprio</li>
        <li>Clique em <strong>"RENDERIZAR"</strong></li>
        <li>A imagem será gerada pelo Vercel</li>
        <li>Baixe ou imprima conforme necessário</li>
      </ol>
    </div>

    <div class="info-box" style="margin-top: 20px;">
      <strong>🔧 Tecnologia:</strong><br>
      Frontend: GitHub Pages (estático)<br>
      Backend: Vercel (serverless Node.js)<br>
      Renderizador: Labelize API
    </div>

    <div class="info-box" style="margin-top: 10px;">
      <strong>🚀 Fluxo:</strong><br>
      1. Você carrega arquivo ZPL<br>
      2. Frontend envia para Vercel<br>
      3. Vercel processa com Labelize<br>
      4. Retorna PNG/PDF pronto<br>
      5. Você visualiza e imprime
    </div>

    <div class="info-box" style="margin-top: 10px;">
      <strong>🔒 Privacidade:</strong><br>
      Seus arquivos são processados no Vercel (backend) e não são armazenados permanentemente.
    </div>
  </div>
</div>

<script>
// Configurar API backend
const BACKEND_URL = 'https://seu-projeto.vercel.app'; // Substituir com seu URL Vercel

let arquivoAtual = null;
let imagemAtual = null;

function abrirAba(nome) {
  document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
  
  document.getElementById(nome).classList.add('active');
  event.target.classList.add('active');
}

// ===== UPLOAD & DRAG-DROP =====

const uploadArea = document.getElementById('uploadArea');

['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
  uploadArea.addEventListener(eventName, preventDefaults, false);
});

['dragenter', 'dragover'].forEach(eventName => {
  uploadArea.addEventListener(eventName, () => uploadArea.classList.add('dragover'), false);
});

['dragleave', 'drop'].forEach(eventName => {
  uploadArea.addEventListener(eventName, () => uploadArea.classList.remove('dragover'), false);
});

uploadArea.addEventListener('drop', (e) => {
  const files = e.dataTransfer.files;
  document.getElementById('fileInput').files = files;
  handleFileSelect({ target: { files } });
}, false);

function preventDefaults(e) {
  e.preventDefault();
  e.stopPropagation();
}

function handleFileSelect(event) {
  const files = event.target.files;
  if (!files.length) return;

  const file = files[0];
  const reader = new FileReader();

  reader.onload = (e) => {
    arquivoAtual = e.target.result;
    document.getElementById('fileName').textContent = file.name;
    document.getElementById('fileSize').textContent = (file.size / 1024).toFixed(2) + ' KB';
    document.getElementById('fileList').style.display = 'block';
    mostrarStatus('✅ Arquivo carregado!', 'success', 'status');
  };

  reader.readAsText(file);
}

function limparArquivo() {
  arquivoAtual = null;
  document.getElementById('fileInput').value = '';
  document.getElementById('fileList').style.display = 'none';
  document.getElementById('preview').innerHTML = `
    <div class="preview-placeholder">
      <p style="font-size: 24px;">📋</p>
      <p>Sua etiqueta aparecerá aqui</p>
    </div>
  `;
  document.getElementById('btnDownload').disabled = true;
  document.getElementById('btnImprimir').disabled = true;
  mostrarStatus('', '', 'status');
}

// ===== CONVERTER ZPL =====

async function converterZPL() {
  if (!arquivoAtual) {
    mostrarStatus('❌ Carregue um arquivo primeiro', 'error', 'status');
    return;
  }

  const btn = document.getElementById('btnConverter');
  const loading = document.getElementById('loading');

  btn.disabled = true;
  loading.style.display = 'block';
  mostrarStatus('⏳ Enviando para Vercel...', 'info', 'status');

  try {
    const response = await fetch(`${BACKEND_URL}/api/convert`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        zplContent: arquivoAtual,
        format: 'png',
        dpmm: '8',
        width: '4',
        height: '6'
      })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.message || `Erro ${response.status}`);
    }

    const result = await response.json();
    imagemAtual = result.data;

    const preview = document.getElementById('preview');
    preview.innerHTML = `<img src="${imagemAtual}" alt="Etiqueta renderizada">`;

    document.getElementById('btnDownload').disabled = false;
    document.getElementById('btnImprimir').disabled = false;

    mostrarStatus('✅ Etiqueta renderizada com sucesso!', 'success', 'status');

  } catch (error) {
    mostrarStatus(`❌ Erro: ${error.message}`, 'error', 'status');
    console.error('Converter error:', error);
  } finally {
    btn.disabled = false;
    loading.style.display = 'none';
  }
}

async function converterZPLEditor() {
  const zpl = document.getElementById('zplCode').value.trim();
  if (!zpl) {
    mostrarStatus('❌ Digite código ZPL', 'error', 'statusEditor');
    return;
  }

  const loading = document.getElementById('loadingEditor');
  loading.style.display = 'block';
  mostrarStatus('⏳ Renderizando...', 'info', 'statusEditor');

  try {
    const response = await fetch(`${BACKEND_URL}/api/convert`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        zplContent: zpl,
        format: 'png'
      })
    });

    if (!response.ok) throw new Error(`Erro ${response.status}`);

    const result = await response.json();
    imagemAtual = result.data;

    const preview = document.getElementById('previewEditor');
    preview.innerHTML = `<img src="${imagemAtual}" alt="ZPL renderizado">`;

    document.getElementById('btnDownloadEditor').disabled = false;
    document.getElementById('btnImprimirEditor').disabled = false;

    mostrarStatus('✅ Renderizado com sucesso!', 'success', 'statusEditor');

  } catch (error) {
    mostrarStatus(`❌ Erro: ${error.message}`, 'error', 'statusEditor');
  } finally {
    loading.style.display = 'none';
  }
}

function baixar() {
  if (!imagemAtual) return;
  const link = document.createElement('a');
  link.href = imagemAtual;
  link.download = `etiqueta-${new Date().getTime()}.png`;
  link.click();
  mostrarStatus('✅ Download iniciado!', 'success', 'status');
}

function baixarEditor() {
  if (!imagemAtual) return;
  const link = document.createElement('a');
  link.href = imagemAtual;
  link.download = `zpl-${new Date().getTime()}.png`;
  link.click();
  mostrarStatus('✅ Download iniciado!', 'success', 'statusEditor');
}

function imprimir() {
  if (!imagemAtual) return;
  const w = window.open('', '', 'width=800,height=600');
  w.document.write(`<img src="${imagemAtual}" style="max-width: 100%;">`);
  w.print();
}

function imprimirEditor() {
  if (!imagemAtual) return;
  const w = window.open('', '', 'width=800,height=600');
  w.document.write(`<img src="${imagemAtual}" style="max-width: 100%;">`);
  w.print();
}

function limparEditor() {
  document.getElementById('zplCode').value = '';
  document.getElementById('previewEditor').innerHTML = `
    <div class="preview-placeholder">
      <p style="font-size: 24px;">🎨</p>
      <p>Imagem será gerada aqui</p>
    </div>
  `;
  document.getElementById('btnDownloadEditor').disabled = true;
  document.getElementById('btnImprimirEditor').disabled = true;
  imagemAtual = null;
}

function mostrarStatus(msg, tipo, id) {
  const el = document.getElementById(id);
  if (!msg) {
    el.innerHTML = '';
    return;
  }
  el.textContent = msg;
  el.className = `status-message show ${tipo}`;
  
  if (tipo === 'success') {
    setTimeout(() => el.classList.remove('show'), 4000);
  }
}
</script>

</body>
</html>
